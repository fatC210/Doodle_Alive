# Comma-separated origins allowed to use user-generated D-ID client keys.
DID_ALLOWED_DOMAINS=https://doodle-alive.vercel.app/
# Optional D-ID voice/LLM overrides.
DID_LLM_PROVIDER=openai
DID_LLM_MODEL=gpt-4.1-mini
DID_MICROSOFT_VOICE_ID=en-US-JennyMultilingualV2Neural
DID_ELEVENLABS_VOICE_ID=
DID_ELEVENLABS_MODEL_ID=

# Optional fallback D-ID Agent Embed credentials (public, browser-safe).
# Newly created characters store their own generated DID agent id/client key.
NEXT_PUBLIC_DID_AGENT_ID=
NEXT_PUBLIC_DID_CLIENT_KEY=
# Optional override; defaults to https://agent.d-id.com/v2/index.js
NEXT_PUBLIC_DID_EMBED_SRC=
